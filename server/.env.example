# Copy to .env and fill in. The first five have NO default: no value, no boot.
# Values here are placeholders, never real secrets.

# The OWNER login. Migrations, seeds and tests. Required, must parse as a URL.
DATABASE_URL=postgres://tasks:CHANGEME@localhost:5432/tasks

# The login the internet reaches. Owns nothing, cannot CREATE, cannot DELETE an
# audit row. Required, no default - the fallback would silently be the owner.
APP_DATABASE_URL=postgres://tasks_app:CHANGEME@localhost:5432/tasks

# Required. development | test | production
NODE_ENV=development
# Required. Comma separated, no spaces needed.
ALLOWED_ORIGINS=http://localhost:5173
# Required. true/1/yes/on or false/0/no/off. Only true behind a proxy you control.
TRUST_PROXY=false

# Optional - config.ts has a default for each of these three.
# PORT=3000
# HOST=127.0.0.1
# LOG_LEVEL=info